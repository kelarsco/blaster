# =============================================================================
# wiblaster server environment variables
# Copy to server/.env and fill in values. Never commit server/.env.
# =============================================================================

# --- Required ---

# PostgreSQL connection (Neon, Supabase-as-Postgres, Railway Postgres, etc.)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Session secret – required for Google OAuth and Express sessions (use a long random string)
SESSION_SECRET=your-long-random-session-secret

# --- Google OAuth (optional – email/password auth works without this) ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match GOOGLE_CALLBACK_URL (or auto-detected callback)
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx
# Local dev (Vite on :3000, API on :4000)
# GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
# FRONTEND_URL=http://localhost:3000

# Production (wiblaster.com — used for referral links, OAuth redirects, invite emails)
# FRONTEND_URL=https://wiblaster.com
# GOOGLE_CALLBACK_URL=https://wiblaster.com/api/auth/google/callback

# Legacy Railway (if API-only on Railway)
# GOOGLE_CALLBACK_URL=https://your-backend.up.railway.app/api/auth/google/callback
# GOOGLE_CALLBACK_BASE_URL=https://your-backend.up.railway.app

# --- JWT / refresh tokens ---
# JWT_ACCESS_SECRET=your-access-secret
# JWT_ACCESS_TTL_SEC=900
# JWT_REFRESH_TTL_DAYS=7
# REFRESH_COOKIE_NAME=wiblaster_rt

# --- Cross-origin cookies (required when frontend and backend are on different domains) ---
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none
# COOKIE_DOMAIN=

# --- Resend transactional email (recommended) ---
# Used for: signup verification OTP, resend verification, password reset,
# deactivation confirmation, subscription confirmation, invite-accepted notification
# Get API key at https://resend.com
RESEND_API_KEY=re_xxxx
# Use an address on your verified Resend domain:
# VERIFICATION_EMAIL_FROM=no-reply@yourdomain.com
# VERIFICATION_EMAIL_FROM_NAME=wiblaster

# --- SMTP fallback (optional – used if RESEND_API_KEY is not set) ---
# Also used for team invite emails in invites.js
# INVITE_SMTP_HOST=smtp.gmail.com
# INVITE_SMTP_PORT=587
# INVITE_SMTP_USER=you@gmail.com
# INVITE_SMTP_PASS=your-app-password
# INVITE_EMAIL_FROM=noreply@yourdomain.com

# --- Paystack billing ---
# Test: sk_test_xxx / pk_test_xxx  |  Live: sk_live_xxx / pk_live_xxx
PAYSTACK_SECRET_KEY=sk_test_xxx
# PAYSTACK_PUBLIC_KEY=pk_test_xxx
# PAYSTACK_CURRENCY=NGN
# PAYSTACK_USD_TO_NGN=1600
# PAYSTACK_SYNC_VERBOSE=1
# Webhook URL in Paystack Dashboard: https://your-backend.com/api/billing/webhook

# --- Admin dashboard (/bl-admin) ---
# Generate base32 secret: node server/scripts/generate-admin-totp.js
# Add to Google Authenticator, then set here (server-side only – never expose to client):
BL_ADMIN_TOTP_SECRET=JBSWY3DPEHPK3PXP
# BL_ADMIN_JWT_SECRET=your-admin-jwt-secret

# --- Optional: server ---
# PORT=4000
# NODE_ENV=production
# DB_INIT_ATTEMPTS=5
# DB_INIT_EXIT=1

# --- Optional: scanner tuning ---
# SCAN_CONCURRENCY=2
# SCAN_CACHE_TTL_DAYS=7
# SCAN_PER_STORE_TIMEOUT_MS=60000

# --- Optional: domain workspace email ---
# DOMAIN_EMAIL_WEBHOOK_SECRET=
# SENDGRID_API_KEY=
# MAILGUN_API_KEY=

# --- Optional: translation ---
# LIBRE_TRANSLATE_URL=https://libretranslate.com
# LIBRE_TRANSLATE_API_KEY=
