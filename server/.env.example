# Neon PostgreSQL – get from https://neon.tech dashboard → Connection string
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Optional: port (default 4000)
# PORT=4000

# Google OAuth (optional – if not set, /api/auth/me returns a dev user and app works without login)
# Get from https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxx
# Set redirect URI in Google Console to: http://localhost:3000/api/auth/google/callback (when using Vite dev)
# GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
# FRONTEND_URL=http://localhost:3000

# Session secret (use a long random string in production)
# SESSION_SECRET=your-secret-key
