# Neon PostgreSQL – required for signup/login and campaigns. Get from https://neon.tech
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Optional: port (default 4000)
# PORT=4000

# Google OAuth (optional – if not set, /api/auth/me returns a dev user and app works without login)
# Get from https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxx
# Set redirect URI in Google Console to: http://localhost:3000/api/auth/google/callback (when using Vite dev)
# GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
# FRONTEND_URL=http://localhost:3000

# Session secret (use a long random string in production). With DATABASE_URL set, sessions are stored in PostgreSQL and survive server restarts.
# SESSION_SECRET=your-secret-key

# Token auth: JWT access (short-lived) + refresh token (HttpOnly cookie, DB). Optional – falls back to SESSION_SECRET.
# JWT_ACCESS_SECRET=your-access-secret
# JWT_REFRESH_SECRET=your-refresh-secret
# JWT_ACCESS_TTL_SEC=900
# JWT_REFRESH_TTL_DAYS=7
# REFRESH_COOKIE_NAME=wiblaster_rt
# Optional: DB init failure behavior. Default: server keeps running without DB. Set DB_INIT_EXIT=1 to exit on DB failure.
# DB_INIT_ATTEMPTS=5

# Invite emails – optional. If set, invite links are emailed to teammates.
# INVITE_SMTP_HOST=smtp.gmail.com
# INVITE_SMTP_PORT=587
# INVITE_SMTP_USER=you@gmail.com
# INVITE_SMTP_PASS=your-app-password
# INVITE_EMAIL_FROM=noreply@wiblaster.com

# Verification code sign-in + transactional emails (Resend or SMTP). If set, users can sign in with "Email me a code".
# Resend (recommended): https://resend.com – get API key and set:
# RESEND_API_KEY=re_xxxx
# Same key is used for: verification codes, password reset, deactivation confirmation, subscription confirmation, invite-accepted notification.
# Optional: VERIFICATION_EMAIL_FROM=no-reply@wiblaster.com (default) – use an address on your verified Resend domain
# Fallback: use same INVITE_SMTP_* as below to send codes via SMTP

# Paystack subscriptions – plans are created automatically from your API key
# Use LIVE keys for production (real charges): PAYSTACK_SECRET_KEY=sk_live_xxx and PAYSTACK_PUBLIC_KEY=pk_live_xxx
# Use TEST keys for development: sk_test_xxx / pk_test_xxx (no real charges)
# PAYSTACK_SECRET_KEY=sk_live_xxx
# PAYSTACK_PUBLIC_KEY=pk_live_xxx
# Plan amounts in DB are in USD cents. For NGN, a live USD→NGN rate is fetched automatically (cached 1h). Optional override:
# PAYSTACK_USD_TO_NGN=1600
# Optional: currency (default NGN)
# PAYSTACK_CURRENCY=NGN
# Webhook URL in Paystack Dashboard: https://your-domain.com/api/billing/webhook

# Admin dashboard (/bl-admin) – login with 6-digit code from Google Authenticator
# Generate a base32 secret (e.g. run: node -e "console.log(require('speakeasy').generate_secret().base32)")
# Add it to Google Authenticator app, then set here:
# BL_ADMIN_TOTP_SECRET=JBSWY3DPEHPK3PXP
# Optional: separate JWT secret for admin cookie (defaults to SESSION_SECRET)
# BL_ADMIN_JWT_SECRET=your-admin-jwt-secret

# Optional: translate non-English store pages (e.g. French/Spanish) to English before extracting emails.
# Leave unset to use public LibreTranslate; set LIBRE_TRANSLATE_API_KEY for https://libretranslate.com
# LIBRE_TRANSLATE_URL=https://libretranslate.com
# LIBRE_TRANSLATE_API_KEY=
